# PulsePilot AI Backend Configuration

APP_NAME=PulsePilot AI

# MongoDB Configuration
# Local MongoDB: mongodb://localhost:27017
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=pulsepilot

# Security
JWT_SECRET=change-this-to-a-random-32-character-secret-in-production

# Default AI Provider ("gemini" or "ollama")
AI_PROVIDER=gemini

# Google Gemini API (Get free API key at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local AI Configuration (Install from https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
